@prefix :     <http://example.org/philosophy#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base         <http://example.org/philosophy> .

###############################################################################
#  PHILOSOPHY DATASET v1 - instances for the ontology in philosophy_ontology.ttl
#  Data only (no ontology header, no owl:imports), so it loads straight into
#  Fuseki / GraphDB / RDFLib next to the ontology file. For Protege use
#  philosophy_complete.ttl (ontology + this dataset in one file).
#
#  Curated starter set cross-checked against the live Wikidata SPARQL endpoint
#  (query.wikidata.org, 2026-11-21); see REPORT.md Section 8 for the audit and
#  for the divergences that were deliberately retained.
#
#  Year convention: years are xsd:int, with BCE written as a negative number
#  (-428 = 428 BCE). xsd:gYear is NOT used: it is outside the OWL 2 datatype
#  map, so HermiT and Pellet refuse to load an ontology containing it.
#
#  BCE numbering: this dataset uses HISTORICAL numbering, where -428 means
#  428 BCE and there is no year zero. Wikidata serialises dates in ISO-8601
#  ASTRONOMICAL numbering, which does have a year zero, so Wikidata's
#  "-0383" is the same instant as our "-384". The two therefore differ by
#  one for every BCE date; this is a convention offset, not a data error.
#  See REPORT.md Section 8.
#
#  Ancient work years are left out on purpose (uncertain), and some
#  philosophers/works have no school, to exercise OPTIONAL patterns.
###############################################################################

# ---- time periods ---
:ClassicalGreece a :TimePeriod ; rdfs:label "Classical Greece"@en ; :startYear "-500"^^xsd:int ; :endYear "-323"^^xsd:int .
:MedievalPeriod a :TimePeriod ; rdfs:label "Medieval period"@en ; :startYear "476"^^xsd:int ; :endYear "1453"^^xsd:int .
:EarlyModernPeriod a :TimePeriod ; rdfs:label "Early modern period"@en ; :startYear "1454"^^xsd:int ; :endYear "1800"^^xsd:int .
:NineteenthCentury a :TimePeriod ; rdfs:label "Nineteenth century"@en ; :startYear "1801"^^xsd:int ; :endYear "1900"^^xsd:int .
:TwentiethCentury a :TimePeriod ; rdfs:label "Twentieth century"@en ; :startYear "1901"^^xsd:int ; :endYear "2000"^^xsd:int .

# ---- places ---
:Greece a :Country ; rdfs:label "Greece"@en .
:Athens a :City ; rdfs:label "Athens"@en ; :locatedIn :Greece .
:Prussia a :Country ; rdfs:label "Prussia (historical)"@en .
:Konigsberg a :City ; rdfs:label "Königsberg"@en ; :locatedIn :Prussia .
:France a :Country ; rdfs:label "France"@en .
:Paris a :City ; rdfs:label "Paris"@en ; :locatedIn :France .

# ---- schools ---
:WesternPhilosophy a :SchoolOfThought ; rdfs:label "Western philosophy"@en .
:AncientGreekPhilosophy a :SchoolOfThought ; rdfs:label "Ancient Greek philosophy"@en ; :subSchoolOf :WesternPhilosophy .
:Platonism a :SchoolOfThought ; rdfs:label "Platonism"@en ; :subSchoolOf :AncientGreekPhilosophy .
:Peripatetic a :SchoolOfThought ; rdfs:label "Peripatetic school"@en ; :subSchoolOf :AncientGreekPhilosophy .
:Stoicism a :SchoolOfThought ; rdfs:label "Stoicism"@en ; :subSchoolOf :AncientGreekPhilosophy .
:MedievalPhilosophy a :SchoolOfThought ; rdfs:label "Medieval philosophy"@en ; :subSchoolOf :WesternPhilosophy .
:Scholasticism a :SchoolOfThought ; rdfs:label "Scholasticism"@en ; :subSchoolOf :MedievalPhilosophy .
:Thomism a :SchoolOfThought ; rdfs:label "Thomism"@en ; :subSchoolOf :Scholasticism .
:EarlyModernPhilosophy a :SchoolOfThought ; rdfs:label "Early modern philosophy"@en ; :subSchoolOf :WesternPhilosophy .
:Rationalism a :SchoolOfThought ; rdfs:label "Rationalism"@en ; :subSchoolOf :EarlyModernPhilosophy .
:Empiricism a :SchoolOfThought ; rdfs:label "Empiricism"@en ; :subSchoolOf :EarlyModernPhilosophy .
:ContinentalPhilosophy a :SchoolOfThought ; rdfs:label "Continental philosophy"@en ; :subSchoolOf :WesternPhilosophy .
:GermanIdealism a :SchoolOfThought ; rdfs:label "German idealism"@en ; :subSchoolOf :ContinentalPhilosophy .
:Phenomenology a :SchoolOfThought ; rdfs:label "Phenomenology"@en ; :subSchoolOf :ContinentalPhilosophy .
:Existentialism a :SchoolOfThought ; rdfs:label "Existentialism"@en ; :subSchoolOf :ContinentalPhilosophy .
:AnalyticPhilosophy a :SchoolOfThought ; rdfs:label "Analytic philosophy"@en ; :subSchoolOf :WesternPhilosophy .

# ---- concepts ---
:TheoryOfForms a :Concept ; rdfs:label "Theory of Forms"@en .
:FormOfTheGood a :Concept ; rdfs:label "Form of the Good"@en .
:Causality a :Concept ; rdfs:label "Causality"@en .
:TranscendentalIdealism a :Concept ; rdfs:label "Transcendental idealism"@en .
:KantianCategories a :Concept ; rdfs:label "Kantian categories"@en .
:PictureTheory a :Concept ; rdfs:label "Picture theory of meaning"@en .
:PhenomenologicalMethod a :Concept ; rdfs:label "Phenomenological method"@en .
:Being a :Concept ; rdfs:label "Being"@en .
:BeingTowardDeath a :Concept ; rdfs:label "Being-toward-death"@en .

